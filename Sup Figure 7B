txi <- read.csv("txi_umair.csv", row.names = 1, header = TRUE)

dim(txi)

# Select only the columns that contain raw counts
count_data <- txi[, grep("^counts\\.", colnames(txi))]  # Extract only count columns
colnames(count_data) <- gsub("^counts\\.", "", colnames(count_data))  # Clean column names
design$Chromosome <- relevel(as.factor(design$Chromosome), ref = "X")
design$Hormone <- relevel(as.factor(design$Hormone), ref = "F")

dds <- DESeqDataSetFromMatrix(countData = round(count_data), 
                              colData = design, 
                              design = ~ Hormone + Chromosome + Hormone:Chromosome)

plot(rowMeans(round(count_data)), apply(round(count_data), 1, var), log="xy")
abline(0,1, lwd=2, lty=2)

#Basic Usage 
dds = DESeq(dds)

#Graphical Check for model mean-disp fitting
plotDispEsts(dds)

#Model fit seems a good fit for data
resultsNames(dds)


res_mrvsme_brain = results(dds,name="Chromosome_Y_vs_X")
res_mrvsme_brain_shrink = lfcShrink(dds, coef =  "Chromosome_Y_vs_X", type="ashr")

summary(res_mrvsme_brain_shrink)
plotMA(res_mrvsme_brain_shrink)

