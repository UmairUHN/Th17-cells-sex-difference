#Here we define me as reference factor for DE analyses
design$group = relevel(as.factor(design$group), ref="me")
#uplad txi files created for same sample name from Kallisto
txi = readRDS("MRMESP_subset_txi.rds")

#In design: group for me vs mr analysis while pair id for pairing the mice sarcrificed at closer time point

dds = DESeqDataSetFromMatrix(countData= round(txi$counts), colData = design, design = ~pair_id+group)
plot(rowMeans(round(txi$counts)), apply(round(txi$counts), 1, var), log="xy")
abline(0,1, lwd=2, lty=2)
#We do have indeed some surdispersion

#Basic Usage 
dds = DESeq(dds)

#Graphical Check for model mean-disp fitting
plotDispEsts(dds)

#Model fit seems a good fit for data
resultsNames(dds)

res_mrvsme_brain = results(dds,name="group_mr_vs_me")
res_mrvsme_brain_shrink = lfcShrink(dds, coef =  "group_mr_vs_me", type="ashr")

summary(res_mrvsme_brain_shrink)
plotMA(res_mrvsme_brain_shrink)

res_mrvsme_brain_shrink.df <- as.data.frame(res_mrvsme_brain_shrink)

res_mrvsme_brain_shrink.df$symbol <-mapIds(org.Mm.eg.db, keys = rownames(res_mrvsme_brain_shrink.df), keytype = "ENSEMBL",column = 'SYMBOL')
res_mrvsme_brain_shrink.df

