library(tidyverse)
library(tximport)     
library(DESeq2)        
library(apeglm)       
library(RColorBrewer)
library(pheatmap)     
library(ggrepel)       

####################################################################
# DESeq2 analysis: female 1C6 vs XX Th17 cells
####################################################################

#Prepare the list of files to import (fichier)
fichiers <- dir(path = "RNAseq/quant/autres/female_1C6_vs_XX_Th17_cells", pattern = "tsv", recursive = TRUE, full.names = TRUE)
names(fichiers) <- dir("RNAseq/quant/autres/female_1C6_vs_XX_Th17_cells")

#Do the correspondance between genes and transcripts IDs and import counts
tx2gene <- read_tsv("RNAseq/tx2gene.tsv")
txi <- tximport(fichiers, type = "kallisto", tx2gene = tx2gene)

#Write the counts to an object
data <- txi$counts %>%
  round() %>%
  data.frame()

#Create metadata
sampletype <- factor(c(rep("female",3), rep("xx", 3)))
meta <- data.frame(sampletype, row.names = colnames(txi$counts))

#Check that sample names match in both files
all(colnames(txi$counts) %in% rownames(meta))
all(colnames(txi$counts) == rownames(meta))

#Create DESeq2Dataset object
dds <- DESeqDataSetFromTximport(txi, colData = meta, design = ~ sampletype)

#set the factor level (female as reference)
dds$sampletype <- relevel(dds$sampletype, ref = "female")

#Run analysis and summarize it
dds <- DESeq(dds)
res <- results(dds)
summary(res)

#Plot dispersion estimates
plot(log(mcols(dds)$baseMean), log(mcols(dds)$baseVar))
abline(a=0,b=1, col="red", lwd=2, lty=2)
plotDispEsts(dds, ylim = c(1e-4, 1e1))

#Non-parametric regression "local" and MAP recalculation to adjust the mathematical approach to our actual gene set dispersion and variance
dds <- estimateDispersionsFit(dds, fitType = "local")
dds <- estimateDispersionsMAP(dds)

plotDispEsts(dds, ylim = c(1e-4, 1e1))


#Extract results
res_table <- results(dds, alpha = 0.05)
summary(res_table)

#Filter results
res_table %>%
  data.frame()

#Filter genes by zero expression
res_table[which(res_table$baseMean == 0),] %>%
  data.frame()

#Filter genes that have an extreme outlier
res_table[which(is.na(res_table$pvalue) &
                  is.na(res_table$padj) &
                  res_table$baseMean > 0),] %>%
  data.frame()

#Filter genes below the low mean threshold
res_table[which(!is.na(res_table$pvalue) &
                  is.na(res_table$padj) &
                  res_table$baseMean > 0),] %>%
  data.frame()

#Apply fold change shrinkage
resultsNames(dds)
res_table <- lfcShrink(dds, coef="sampletype_xx_vs_female", type="apeglm")

#MA plot using shrunken fold changes
plotMA(res_table, ylim=c(-10,10))

#Summarize results
summary(res_table, alpha = 0.05)

#Set thresholds
padj.cutoff <- 0.05
lfc.cutoff  <- 0.4

#Create a tibble of results
res_table_tb <- res_table %>%
  data.frame() %>%
  rownames_to_column(var="gene") %>%
  as_tibble()


####################################################################
# Annotation
####################################################################

#Merge together (ensembl IDs), the normalized counts data frame with a subset of the annotations in the tx2gene data frame
musmusculusannot <- tx2gene %>%
  dplyr::select(GENEID, GENENAME) %>%
  dplyr::distinct()

#Subset the tibble to keep only significant genes (padj AND log2FC thresholds)
sig <- res_table_tb %>%
  filter(padj < padj.cutoff, abs(log2FoldChange) >= lfc.cutoff) %>%
  left_join(musmusculusannot, by = c("gene" = "GENEID"))

#Create a metadata tibble from the data frame (don't lose the row names)
mouse_meta <- meta %>%
  rownames_to_column(var="samplename") %>%
  as_tibble()

#Convert normalized_counts to a data frame and transfer the row names to a new column called "gene"
normalized_counts <- counts(dds, normalized=TRUE) %>%
  data.frame() %>%
  rownames_to_column(var="gene") %>%
  left_join(musmusculusannot, by = c("gene" = "GENEID")) %>%
  as_tibble()


####################################################################
# Volcano plot
####################################################################

volcano_tb <- res_table_tb %>%
  left_join(musmusculusannot, by = c("gene" = "GENEID")) %>%
  filter(!is.na(padj)) %>%
  mutate(
    direction = case_when(
      padj < padj.cutoff & log2FoldChange >=  lfc.cutoff ~ "Up",
      padj < padj.cutoff & log2FoldChange <= -lfc.cutoff ~ "Down",
      TRUE ~ "NS"
    ),
    direction = factor(direction, levels = c("Up", "Down", "NS"))
  )

#Label the top 20 by padj among genes passing both cutoffs
top_labels <- volcano_tb %>%
  filter(direction != "NS") %>%
  arrange(padj) %>%
  head(20)

ggplot(volcano_tb, aes(x = log2FoldChange, y = -log10(padj))) +
  geom_point(aes(color = direction), size = 1.2, alpha = 0.7) +
  scale_color_manual(values = c(Up = "#B2182B", Down = "#2166AC", NS = "grey80")) +
  geom_vline(xintercept = c(-lfc.cutoff, lfc.cutoff),
             linetype = "dashed", color = "grey40") +
  geom_hline(yintercept = -log10(padj.cutoff),
             linetype = "dashed", color = "grey40") +
  ggrepel::geom_text_repel(data = top_labels, aes(label = GENENAME),
                           size = 3, max.overlaps = 20, box.padding = 0.4) +
  xlab(expression(log[2]~"fold change")) +
  ylab(expression(-log[10]~"adjusted p-value")) +
  ggtitle("XX vs female Th17 cells") +
  theme_bw() +
  theme(plot.title = element_text(hjust = 0.5),
        legend.title = element_blank())


####################################################################
# Heatmap
####################################################################

#Extract normalized expression for significant genes (both thresholds applied via sig)
norm_sig <- normalized_counts %>%
  filter(gene %in% sig$gene) %>%
  arrange(match(gene, sig$gene[order(sig$padj)]))

#Label the top 20 by padj (or all of them if fewer than 20)
n_label <- min(20, nrow(norm_sig))
norm_sig <- norm_sig %>%
  mutate(genelabels = "")
norm_sig$genelabels[1:n_label] <- as.character(norm_sig$GENENAME[1:n_label])

#Set a color palette
redandblue <- brewer.pal(8, "RdBu")

#Run pheatmap using the metadata data frame for the annotation
pheatmap(norm_sig[2:7],
         color = rev(redandblue),
         cluster_rows = TRUE,
         cluster_cols = FALSE,
         show_rownames = TRUE,
         show_colnames = FALSE,
         border_color = "black",
         fontsize = 10,
         scale = "row",
         treeheight_row = 0,
         fontsize_row = 20,
         height = 20,
         labels_row = norm_sig$genelabels)

